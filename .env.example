# The browser always calls the same-origin Vercel Function proxy, which forwards to the Java
# backend (be/q-story-backend). The backend owns all Supabase access (Postgres DB + Storage) -
# the browser never talks to Supabase directly.
VITE_QSTORY_API_URL=/api/qstory
VITE_QSTORY_ANALYTICS_URL=/api/qstory/v1/beta-events
VITE_QSTORY_VOICE_RESEARCH_URL=/api/qstory/v1/voice-research
VITE_QSTORY_LANDING_URL=https://qstory.ai.kr

# Set only on the Vercel Function (server-side), never exposed to the
# browser. Points at the separately-deployed backend API. Not a secret.
QSTORY_API_UPSTREAM_URL=https://your-backend-api.example
