# The browser always calls the same-origin Vercel Function proxy, which forwards to the Java
# backend (be/). The backend owns all Supabase access (Postgres DB + Storage) - the browser only
# reads public story images/audio from Supabase Storage (content/registry.yaml assetStorage).
VITE_QSTORY_API_URL=/api/qstory
VITE_QSTORY_ANALYTICS_URL=/api/qstory/v1/beta-events
VITE_QSTORY_VOICE_RESEARCH_URL=/api/qstory/v1/voice-research

# Toss Payments widget client key. Safe to expose in the browser; the secret key stays in the backend.
VITE_TOSS_CLIENT_KEY=

# Social login public identifiers. Leave empty to hide the matching login button.
VITE_GOOGLE_OAUTH_CLIENT_ID=
VITE_KAKAO_JS_KEY=

# Set only on the Vercel Function (server-side), never exposed to the
# browser. Points at the separately-deployed backend API. Not a secret.
# Production: the backend's custom domain (https://api.qstory.ai.kr), not the *.up.railway.app address,
# so moving the Railway service only needs a DNS change.
QSTORY_API_UPSTREAM_URL=https://your-backend-api.example

# Vercel Function only (server-side) - this one IS a secret. Same value as the backend's
# QSTORY_PROXY_SHARED_SECRET (Railway). The proxy signs the visitor's IP with it so the backend's
# per-IP rate limits count each visitor separately instead of lumping everyone under Vercel's IPs.
# Leave empty to skip (backend then counts all web traffic by Vercel's egress IPs).
QSTORY_PROXY_SHARED_SECRET=

# Local-only, used by `npm run content:import` (scripts/import-story-to-backend.mjs) to push
# freshly-generated story content to the backend's DB. Never read by the running app itself.
QSTORY_BACKEND_URL=https://your-backend-api.example
QSTORY_STORY_IMPORT_TOKEN=
