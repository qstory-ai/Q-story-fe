# Default: let Git detect text vs binary, normalize text files to LF in the
# repo, and check them out as LF everywhere (Windows included).
* text=auto eol=lf

# Windows-only entry points must keep CRLF or cmd.exe's parser breaks.
*.bat text eol=crlf
*.cmd text eol=crlf

# Unix shell scripts run inside the Linux container (see Dockerfile) - CRLF
# here fails at the shebang with "bash\r: No such file or directory".
*.sh text eol=lf

# Custom story-content text formats - treat like any other source text.
*.qstory text eol=lf

# Story assets - binary, never diff/merge/EOL-convert as text.
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.mp3 binary
*.woff binary
*.woff2 binary
