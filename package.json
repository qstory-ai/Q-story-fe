{
  "name": "q-story-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run content:check && vite build",
    "build:docker": "npm run content:generate && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "content:generate": "node scripts/generate-story-package.mjs --all",
    "content:validate": "node scripts/generate-story-package.mjs --all --validate",
    "content:check": "node scripts/generate-story-package.mjs --all --check",
    "content:import": "node scripts/import-story-to-backend.mjs --all",
    "content:sync-audio": "node scripts/sync-audio-assets.mjs --all --write",
    "audio:upload": "node scripts/upload-audio-to-supabase.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.34.0",
    "pretendard": "^1.3.9",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-native-web": "^0.21.0",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/react-native-web": "^0.19.2",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.0.0",
    "yaml": "^2.9.0"
  }
}
