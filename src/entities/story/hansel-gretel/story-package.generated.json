            "branchAssetId": "HG-FB-ART-C-DISTRACT-AND-TAKE-KEYS-V1",
            "choiceCopyVariants": [
              {
                "label": "시선 돌리고 열쇠 보기",
                "meaning": "마녀가 다른 곳을 보는 사이 작업대의 열쇠를 확인한다."
              },
              {
                "label": "떨어질 냄비 알려주기",
                "meaning": "작업대 끝의 빈 냄비가 떨어질 것 같다고 말해 마녀의 시선을 돌린다."
              },
              {
                "label": "열쇠 놓을 순간 기다리기",
                "meaning": "마녀가 시범을 위해 열쇠고리를 내려놓는 순간을 기다린다."
              }
            ]
          },
          {
            "id": "C_USE_SIGNAL",
            "meaning": "남매가 문 앞에서 나눈 두 번 두드리기 약속을 떠올려 움직일 순간을 맞춘다.",
            "acknowledgementText": "좋아, 문 앞에서 헨젤과 나눈 약속대로 두 번 두드리는 신호를 보낼게.",
            "reportSummary": "그레텔은 과자집 문 앞에서 나눈 약속을 떠올리고, 헨젤과 빈손으로 탁, 탁 신호를 주고받아 마녀의 시선을 돌린 뒤 함께 탈출했어요.",
            "bridgeAudioId": "BRIDGE-C_USE_SIGNAL",
            "branchAssetId": "HG-FB-ART-C-USE-SIGNAL-V2",
            "requiresPriorFamilyIds": [
              "B_MAKE_SIBLING_SIGNAL"
            ],
            "choiceCopyVariants": [
              {
                "label": "헨젤에게 신호 보내기",
                "meaning": "작업대를 두 번 두드려 헨젤에게 준비하라는 신호를 보낸다."
              },
              {
                "label": "남매가 함께 움직이기",
                "meaning": "두 번 두드리는 신호로 서로의 움직일 때를 맞춘다."
              },
              {
                "label": "쇠창살 답신 기다리기",
                "meaning": "그레텔이 신호를 보낸 뒤 헨젤의 두 번 두드리는 답을 기다린다."
              }
            ]
          },
          {
            "id": "C_CHECK_LOCK_FROM_DISTANCE",
            "meaning": "화덕에 다가가지 않고 열쇠와 잠금 상태를 확인한다.",
            "acknowledgementText": "좋아, 위험하게 다가가지 말고 멀리서 자물쇠 상태를 확인하자.",
            "reportSummary": "그레텔은 긴 빵 주걱으로 잠금 무늬와 철문이 연결된 것을 알아내고 마녀에게 먼저 시범을 요청했어요.",
            "bridgeAudioId": "BRIDGE-C_CHECK_LOCK_FROM_DISTANCE",
            "branchAssetId": "HG-FB-ART-C-CHECK-LOCK-FROM-DISTANCE-V1",
            "choiceCopyVariants": [
              {
                "label": "긴 주걱으로 확인하기",
                "meaning": "화덕에 다가가지 않고 긴 빵 주걱으로 잠금 무늬를 살핀다."
              },
              {
                "label": "멀리서 자물쇠 살피기",
                "meaning": "안전한 거리에서 열쇠와 잠금장치가 연결됐는지 확인한다."
              },
              {
                "label": "떨리는 철문 관찰하기",
                "meaning": "주걱을 가까이 댔을 때 쇠창살과 철문이 움직이는지 본다."
              }
            ]
          },
          {
            "id": "C_BLOCK_PURSUIT_SAFELY",
            "meaning": "문과 주변 물건을 이용해 안전하게 추격을 늦춘다.",
            "acknowledgementText": "좋아, 아무도 다치지 않게 문과 주변 물건으로 마녀를 늦춰보자.",
            "reportSummary": "남매는 열쇠로 헨젤을 풀고 큰 철문을 내려 마녀의 추격을 늦춘 뒤 함께 달아났어요.",
            "bridgeAudioId": "BRIDGE-C_BLOCK_PURSUIT_SAFELY",
            "branchAssetId": "HG-FB-ART-C-BLOCK-PURSUIT-SAFELY-V1",
            "choiceCopyVariants": [
              {
                "label": "문으로 길 막아두기",
                "meaning": "아무도 다치지 않게 문을 닫아 마녀의 추격을 늦춘다."
              },
              {
                "label": "사탕 철문 내리기",
                "meaning": "검은 열쇠를 반대로 돌려 마녀 앞의 사탕 철문을 내린다."
              },
              {
                "label": "안전하게 추격 늦추기",
                "meaning": "헨젤을 먼저 풀어 준 뒤 문과 자물쇠로 거리를 벌린다."
              }
            ]
          }
        ]
      }
