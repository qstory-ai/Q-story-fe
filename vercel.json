{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/qstory-proxy.mjs": {
      "maxDuration": 60,
      "regions": [
        "icn1"
      ],
      "supportsCancellation": true
    }
  },
  "rewrites": [
    {
      "source": "/api/qstory/:path*",
      "destination": "/api/qstory-proxy?path=:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
